---
import '../styles/global.css';
import { nav, isGroup, type NavGroup } from '../data/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  structuredData?: object;
  noindex?: boolean;
}

const { title, description = 'Stage sound for acoustic musicians: the Chester upright bass microphone and AcoustiMatch, hand-built in Utah. Plus tube amps, guitar pedals and the label behind Basin & Grange.', ogImage = '/images/logo-full.jpg', structuredData, noindex = false } = Astro.props;
const currentPath = Astro.url.pathname;
const currentYear = new Date().getFullYear();
const canonicalURL = new URL(currentPath, Astro.site);
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const isActive = (href: string) => norm(currentPath) === norm(href);
const isGroupActive = (group: NavGroup) =>
  group.match.some((prefix) => norm(currentPath).startsWith(prefix)) || group.links.some((l) => isActive(l.href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/images/logo-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content="Molinello Music" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600&family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NPRTSJLMQ7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NPRTSJLMQ7');
    </script>

    <title>{title}</title>

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class="bg-white text-brand-dark font-body min-h-screen flex flex-col">
    <nav class="bg-brand-dark sticky top-0 z-50" aria-label="Main">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-2 shrink-0">
            <img src="/images/logo-icon.png" alt="" class="h-9 w-9" />
            <span class="text-white font-heading font-bold text-lg">Molinello Music</span>
          </a>

          <!-- Desktop nav (lg and up). Below lg the hamburger menu is the only nav. -->
          <ul class="hidden lg:flex items-center gap-1">
            {nav.map((item) => isGroup(item) ? (
              <li class="relative group" data-dropdown>
                <button
                  type="button"
                  aria-expanded="false"
                  aria-haspopup="true"
                  class:list={["flex items-center gap-1 px-3 py-2 text-sm font-heading font-semibold transition-colors rounded cursor-pointer", isGroupActive(item) ? "text-brand-orange" : "text-gray-300 hover:text-brand-orange"]}
                >
                  {item.label}
                  <svg class="w-3 h-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 9l6 6 6-6" /></svg>
                </button>
                <div class="absolute left-0 top-full pt-1 hidden group-hover:block group-focus-within:block group-[.is-open]:block">
                  <ul class="bg-brand-charcoal rounded-lg shadow-xl py-2 min-w-[240px]">
                    {item.links.map((link) => (
                      <li>
                        <a href={link.href} class:list={["block px-4 py-2 hover:bg-white/5 transition-colors", isActive(link.href) ? "text-brand-orange" : "text-gray-200 hover:text-brand-orange"]}>
                          <span class="block text-sm font-heading font-semibold">{link.label}</span>
                          {link.blurb && <span class="block text-xs text-gray-400">{link.blurb}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class:list={["block px-3 py-2 text-sm font-heading font-semibold transition-colors rounded", isActive(item.href) ? "text-brand-orange" : "text-gray-300 hover:text-brand-orange"]}>{item.label}</a>
              </li>
            ))}
          </ul>

          <!-- Mobile menu button (below lg) -->
          <button id="mobile-menu-btn" type="button" class="lg:hidden text-gray-300 hover:text-white p-2 -mr-2" aria-label="Toggle menu" aria-controls="mobile-menu" aria-expanded="false">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

        <!-- Mobile nav (below lg only) -->
        <div id="mobile-menu" class="hidden lg:hidden pb-4 border-t border-white/10">
          <ul class="pt-2">
            {nav.map((item) => isGroup(item) ? (
              <li class="py-1">
                <p class="px-2 pt-2 pb-1 text-[11px] font-heading font-bold uppercase tracking-widest text-gray-500">{item.label}</p>
                <ul>
                  {item.links.map((link) => (
                    <li>
                      <a href={link.href} class:list={["block px-2 py-2 text-base font-heading font-semibold transition-colors", isActive(link.href) ? "text-brand-orange" : "text-gray-200 hover:text-brand-orange"]}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} class:list={["block px-2 py-2 text-base font-heading font-semibold transition-colors", isActive(item.href) ? "text-brand-orange" : "text-gray-200 hover:text-brand-orange"]}>{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-brand-dark text-gray-400 py-10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
        <div class="flex justify-center mb-6">
          <img src="/images/logo-icon.png" alt="Molinello Music" class="h-10 w-10 opacity-80" />
        </div>
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-heading font-semibold mb-6">
          <li><a href="/microphones/chester" class="hover:text-brand-orange transition-colors">Chester</a></li>
          <li><a href="/software/acoustimatch" class="hover:text-brand-orange transition-colors">AcoustiMatch</a></li>
          <li><a href="/amplifiers" class="hover:text-brand-orange transition-colors">Amplifiers</a></li>
          <li><a href="/for-sale" class="hover:text-brand-orange transition-colors">For Sale</a></li>
          <li><a href="/records" class="hover:text-brand-orange transition-colors">Molinello Records</a></li>
          <li><a href="/contact" class="hover:text-brand-orange transition-colors">Contact</a></li>
        </ul>
        <p class="text-xs text-gray-500">&copy; 2024-{currentYear} Molinello Music. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
      });

      // Desktop dropdowns: open on hover/focus via CSS; click toggles for touch screens.
      const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');
      dropdowns.forEach((dd) => {
        const toggle = dd.querySelector('button');
        toggle?.addEventListener('click', () => {
          const open = !dd.classList.contains('is-open');
          dropdowns.forEach((other) => {
            other.classList.remove('is-open');
            other.querySelector('button')?.setAttribute('aria-expanded', 'false');
          });
          dd.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
        });
      });
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('[data-dropdown]')) {
          dropdowns.forEach((dd) => {
            dd.classList.remove('is-open');
            dd.querySelector('button')?.setAttribute('aria-expanded', 'false');
          });
        }
      });
    </script>

  </body>
</html>
