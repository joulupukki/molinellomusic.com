---
import BaseLayout from '../layouts/BaseLayout.astro';
import { album, chesterBuyUrl } from '../data/site';

const videos = [
  {
    id: 'LWgeRZLm08I',
    title: 'Basin & Grange live at The Gandy with Chester on upright bass',
    caption: 'Basin & Grange at The Gandy, Ogden, UT, with Chester on upright bass.',
  },
  {
    id: 'iQT9kJUMJqY',
    title: 'Chester on upright bass in a live mix',
    caption: 'Another live mix with Chester on the bass.',
  },
  {
    id: 'l0621b7QQWo',
    title: 'Upright bass mic placement: how position changes the sound',
    caption: 'Same part, different mic positions. Hear what changes.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Molinello Music',
  url: 'https://www.molinellomusic.com',
  logo: 'https://www.molinellomusic.com/images/logo-full.jpg',
  description: 'A small workshop in Utah building gear that helps acoustic musicians sound like themselves on stage.',
};
---

<BaseLayout
  title="Molinello Music: Stage Sound for Acoustic Musicians"
  description="Hand-built gear that helps acoustic musicians sound like themselves on stage. Chester upright bass microphone ($449) and AcoustiMatch pickup software, made in Utah."
  ogImage="/images/chester/chester-v2-mounted-front.jpg"
  structuredData={structuredData}
>
  <!-- Hero: Chester -->
  <section class="bg-brand-dark text-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-20">
      <div class="md:flex md:items-center md:gap-12">
        <div class="md:w-1/2 mb-8 md:mb-0 md:order-2">
          <img
            src="/images/chester/chester-v2-mounted-front.jpg"
            alt="Chester microphone mounted between the strings of an upright bass"
            class="w-full rounded-xl shadow-2xl aspect-[4/3] object-cover"
            fetchpriority="high"
          />
        </div>
        <div class="md:w-1/2 md:order-1">
          <p class="text-brand-orange font-heading font-bold text-sm uppercase tracking-widest mb-3">Upright bass microphone</p>
          <h1 class="font-heading font-extrabold text-5xl md:text-6xl tracking-tight mb-4">Chester</h1>
          <p class="text-gray-300 text-lg md:text-xl leading-relaxed mb-6 max-w-lg">
            A hand-built condenser that mounts between the strings in seconds and puts the natural sound of your upright bass in front of the audience.
          </p>
          <p class="mb-6">
            <span class="font-heading font-extrabold text-3xl">$449</span>
            <span class="text-gray-400 text-sm ml-2">introductory price</span>
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/microphones/chester" class="text-center bg-brand-orange text-white font-heading font-bold px-6 py-3 rounded-lg hover:bg-orange-600 transition-colors">
              Meet Chester
            </a>
            <a href={chesterBuyUrl} target="_blank" rel="noopener noreferrer" class="text-center border-2 border-white/30 text-white font-heading font-bold px-6 py-3 rounded-lg hover:border-brand-orange hover:text-brand-orange transition-colors">
              Buy now
            </a>
          </div>
          <p class="text-gray-400 text-sm mt-4">30-day audition &middot; lifetime warranty &middot; free U.S. shipping</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tagline -->
  <section class="bg-brand-warm py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <p class="font-heading font-extrabold text-2xl md:text-4xl text-brand-dark mb-4 text-balance">
        Your acoustic sound, on any stage.
      </p>
      <p class="text-gray-600 text-lg leading-relaxed">
        I play bluegrass, and I build the gear I wished I had on stage: microphones and software that keep a bass, guitar or mandolin sounding like itself through the PA. Everything is made by hand in Utah.
      </p>
    </div>
  </section>

  <!-- For acoustic players -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p class="text-brand-orange font-heading font-bold text-sm uppercase tracking-widest mb-2 text-center">For acoustic players</p>
      <h2 class="font-heading font-bold text-3xl md:text-4xl text-center mb-12 text-balance">Sound like yourself through the PA</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <a href="/microphones/chester" class="group flex flex-col bg-white rounded-xl shadow-md hover:shadow-xl transition-shadow overflow-hidden border border-black/5">
          <div class="aspect-[4/3] overflow-hidden">
            <img src="/images/chester/chester-v2-mounted-side.jpg" alt="Chester microphone on an upright bass, side view" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <p class="text-sm font-heading font-semibold text-gray-500 mb-1">The problem: pickups make an upright sound plugged in</p>
            <h3 class="font-heading font-bold text-2xl mb-2">Chester</h3>
            <p class="text-gray-600 mb-4 flex-1">
              A condenser tuned for upright bass. It weighs 6.7 oz, installs in under 30 seconds, and gives the sound engineer the woody, open tone you hear standing behind the instrument.
            </p>
            <span class="text-brand-orange font-heading font-bold group-hover:underline">Meet Chester &rarr;</span>
          </div>
        </a>
        <a href="/software/acoustimatch" class="group flex flex-col bg-white rounded-xl shadow-md hover:shadow-xl transition-shadow overflow-hidden border border-black/5">
          <div class="aspect-[4/3] overflow-hidden bg-gradient-to-br from-blue-900 to-blue-600 flex items-center justify-center">
            <img src="/images/acoustimatch/icon.png" alt="AcoustiMatch app icon" loading="lazy" class="w-1/2 rounded-2xl group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <p class="text-sm font-heading font-semibold text-gray-500 mb-1">The problem: a mic isn't practical, and the pickup sounds harsh</p>
            <h3 class="font-heading font-bold text-2xl mb-2">AcoustiMatch</h3>
            <p class="text-gray-600 mb-4 flex-1">
              Software that compares your pickup with a microphone and builds an impulse response, so your pickup sounds as close as possible to that mic. Runs as a standalone app or DAW plugin.
            </p>
            <span class="text-brand-orange font-heading font-bold group-hover:underline">Learn about AcoustiMatch &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- From the workbench -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p class="text-brand-orange font-heading font-bold text-sm uppercase tracking-widest mb-2 text-center">From the workbench</p>
      <h2 class="font-heading font-bold text-3xl md:text-4xl text-center mb-4">Electric builds</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-12">When I'm not building for the acoustic stage, I'm usually wiring up a pedal or a tube amp.</p>
      <div class="grid sm:grid-cols-2 gap-8">
        <a href="/pedals" class="group block bg-white rounded-xl shadow-md hover:shadow-xl transition-shadow overflow-hidden border border-black/5">
          <div class="aspect-[4/3] overflow-hidden">
            <img src="/images/pedals/q-tune.jpg" alt="Q-Tune guitar tuner pedal" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-6">
            <h3 class="font-heading font-bold text-xl mb-1">Guitar Pedals</h3>
            <p class="text-gray-600 text-sm">Q-Tune, the DIY tuner kit. The Flick, an open-source reverb, tremolo and delay pedal.</p>
          </div>
        </a>
        <a href="/amplifiers" class="group block bg-white rounded-xl shadow-md hover:shadow-xl transition-shadow overflow-hidden border border-black/5">
          <div class="aspect-[4/3] overflow-hidden">
            <img src="/images/amplifiers/all-amplifiers.jpg" alt="Hand-built Molinello tube amplifiers and speaker cabinets" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-6">
            <h3 class="font-heading font-bold text-xl mb-1">Amplifiers</h3>
            <p class="text-gray-600 text-sm">Tube amps built from kits and from scratch, from a 2-watt JTM 45 to a pair of blackface-style B-Verbs.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Videos -->
  <section class="py-16 md:py-24 bg-brand-dark text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="font-heading font-bold text-3xl md:text-4xl text-center mb-3">Hear it on stage</h2>
      <p class="text-gray-400 text-center mb-10">Real gigs, real rooms, no studio tricks.</p>
      <div class="grid md:grid-cols-3 gap-6">
        {videos.map((v) => (
          <figure>
            <div class="aspect-video rounded-xl overflow-hidden shadow-lg bg-black">
              <iframe
                src={`https://www.youtube.com/embed/${v.id}`}
                title={v.title}
                class="w-full h-full"
                frameborder="0"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
            <figcaption class="text-gray-400 text-sm mt-3">{v.caption}</figcaption>
          </figure>
        ))}
      </div>
      <p class="text-center mt-8">
        <a href="https://www.youtube.com/playlist?list=PLXizHihKfp9A" target="_blank" rel="noopener noreferrer" class="text-brand-orange font-heading font-bold hover:underline">All Chester videos on YouTube &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Molinello Records -->
  <section class="py-14 md:py-20 bg-brand-warm">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="sm:flex items-center gap-8">
        <a href="/records" class="block shrink-0 w-48 sm:w-56 mx-auto sm:mx-0 mb-6 sm:mb-0">
          <img src={album.cover} alt={`${album.band}: ${album.title} album cover`} loading="lazy" class="rounded-lg shadow-lg w-full" />
        </a>
        <div class="text-center sm:text-left">
          <p class="text-brand-orange font-heading font-bold text-sm uppercase tracking-widest mb-2">Molinello Records</p>
          <h2 class="font-heading font-bold text-2xl md:text-3xl mb-1">{album.band}: <em>{album.title}</em></h2>
          <p class="text-gray-500 text-sm mb-3">Released {album.released}</p>
          <p class="text-gray-600 mb-5">Molinello started as the label for our record. Now we build the gear we play through.</p>
          <div class="flex flex-wrap justify-center sm:justify-start gap-3">
            <a href={album.listen} target="_blank" rel="noopener noreferrer" class="bg-brand-orange text-white font-heading font-bold px-5 py-2.5 rounded-lg hover:bg-orange-600 transition-colors text-sm">Listen</a>
            <a href={album.albumPage} target="_blank" rel="noopener noreferrer" class="border-2 border-brand-dark text-brand-dark font-heading font-bold px-5 py-2 rounded-lg hover:bg-brand-dark hover:text-white transition-colors text-sm">Band website</a>
            <a href="/records" class="font-heading font-bold px-2 py-2.5 text-sm text-brand-dark hover:text-brand-orange transition-colors">More about the record &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
