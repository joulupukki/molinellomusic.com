          <img src="/images/chester/chester-mounted-closeup.jpg" alt="Original Chester V1 microphone mounted on upright bass" class="rounded-lg shadow-sm w-full" />
        </div>
        <div class="md:w-1/2">
          <p class="font-heading font-extrabold text-4xl text-brand-dark mb-2">$299</p>
