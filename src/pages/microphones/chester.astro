---
import BaseLayout from '../../layouts/BaseLayout.astro';

const priceValidUntil = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Chester Condenser Microphone for Upright Bass (V2)',
  description: 'A hand-built cardioid condenser microphone tuned specifically for upright bass. Lightweight, installs in seconds, and ready to plug into 48V phantom power.',
  image: 'https://www.molinellomusic.com/images/chester/chester-v2-mounted-front.jpg',
  brand: {
    '@type': 'Brand',
    name: 'Molinello Music',
  },
  offers: {
    '@type': 'Offer',
    price: '449.00',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: 'https://www.molinellomusic.com/microphones/chester',
    priceValidUntil,
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'US',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 30,
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/ReturnShippingFees',
    },
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: {
        '@type': 'MonetaryAmount',
        value: '0',
        currency: 'USD',
      },
      shippingDestination: {
        '@type': 'DefinedRegion',
        addressCountry: 'US',
      },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: {
          '@type': 'QuantitativeValue',
          minValue: 1,
          maxValue: 14,
          unitCode: 'DAY',
        },
        transitTime: {
          '@type': 'QuantitativeValue',
          minValue: 3,
          maxValue: 7,
          unitCode: 'DAY',
        },
      },
    },
  },
};

const buyNowUrl = 'https://buy.stripe.com/aFabJ12Ud2pbgar6qM8og0p';
---

<BaseLayout title="Chester - Molinello Music" description="The microphone that makes your upright bass sound like YOUR bass. Lighter, faster to install, and tuned specifically for upright." ogImage="/images/chester/chester-v2-mounted-front.jpg" structuredData={productSchema}>
  <!-- Hero -->
  <section class="bg-brand-dark text-white py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
